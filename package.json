{
  "name": "razoragent-os",
  "version": "1.0.0",
  "description": "RazorAgent OS - Autonomous Commerce & Bounded Payment Gateway for Razorpay AI Buildathon 2026",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:client",
    "lint": "npm run lint --workspace=client",
    "dev": "npm run build:client && node server/src/index.js",
    "start": "node server/src/index.js"
  }
}

# RazorAgent OS - Server Environment Configuration Template
PORT=5000

# Razorpay API Credentials (Test Mode)
# Leave empty or set your test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Gemini API Key
# (Optional: If omitted or rate-limited, RazorAgent OS automatically routes to the ACP Failsafe Engine)
GEMINI_API_KEY=

# Protocol Configuration
MERCHANT_NAME=CloudGPU India Tech
MERCHANT_VPA=cloudgpu@razorpay
MERCHANT_CATEGORY=cloud_infrastructure
MANDATE_MAX_CAP_INR=25000
